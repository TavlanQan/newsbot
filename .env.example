# Telegram Bot
TELEGRAM_BOT_TOKEN=ваш_токен_бота

# Database
DB_PATH=./news_bot.db

# RSS Settings
RSS_UPDATE_INTERVAL=10   # в минутах
RSS_FEEDS=https://example.com/rss,https://another.com/feed

# Queue
QUEUE_DELAY_MS=700

# Default Target Channels (опционально, через запятую)
DEFAULT_TARGET_CHANNELS=-1001234567890,-1000987654321

# Logging (опционально)
LOG_LEVEL=info
